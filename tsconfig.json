{
	"compilerOptions": {
		// 使用 Node.js 22 支持的现代语法，避免构建阶段执行不必要的降级转换。
		"target": "ES2022",
		// 强制所有输入按模块处理，避免配置文件退化为全局脚本。
		"moduleDetection": "force",
		// 保留源码中的模块语法，交由 tsdown 统一转换为发布所需的 CommonJS。
		"module": "Preserve",
		// 按打包器规则解析 package exports 和 TypeScript 源文件。
		"moduleResolution": "Bundler",
		// 限定自动引入的 @types 全局声明；标准库类型由 lib 决定。
		"types": ["node"],
		// 启用 strict 选项族；额外检查及单项覆盖由下方选项决定。
		"strict": true,
		// 索引访问结果包含 undefined，强制处理缺失键。
		"noUncheckedIndexedAccess": true,
		// 未使用的局部变量和参数视为错误。
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// TypeScript 只负责类型检查，构建产物由 tsdown 生成。
		"noEmit": true,
		// 兼容以 CommonJS 方式导出的第三方模块。
		"esModuleInterop": true,
		// 防止仅文件名大小写不同的导入在跨平台环境中失效。
		"forceConsistentCasingInFileNames": true,
		// 确保每个文件都能由 tsdown 独立安全地转换。
		"isolatedModules": true,
		// 跳过依赖声明文件检查，避免第三方类型问题影响本项目验证。
		"skipLibCheck": true
	},
	// 检查源码及构建配置，测试目录使用独立的 tsconfig。
	"include": ["src", "tsdown.config.ts"],
	// 排除依赖和发布产物。
	"exclude": ["node_modules", "dist"]
}
